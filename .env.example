APP_NAME=CryptoNews
TRUSTED_PROXIES=
TRUSTED_HOSTS=
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
ADVERTISING_ENABLED=false
DIRECT_ADVERTISING_ENABLED=false
ADVERTISING_MODE=disabled
ADSENSE_ENABLED=false
ADSENSE_PUBLISHER_ID=
PRICE_ALERTS_ENABLED=false
NEWSLETTERS_ENABLED=false
ENGAGEMENT_REAL_EMAIL_ENABLED=false
ENGAGEMENT_EMAILS_PER_MINUTE=60
ENGAGEMENT_BATCH_SIZE=100
MAIL_TIMEOUT=10
NEWS_DISCOVERY_EMERGENCY_STOP=false
AI_EMERGENCY_STOP=true
AI_CANDIDATE_PROCESSING_ENABLED=false
AI_GENERATION_ENABLED=false
AI_TRANSLATION_ENABLED=false
AI_SCHEDULED_GENERATION_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT=30
AI_MAX_CONCURRENT_JOBS=1
AI_MAX_INPUT_TOKENS=32000
AI_MAX_OUTPUT_TOKENS=5000
# Integer micro-USD per 1 million tokens; verify pricing for this exact model.
AI_PRICING_MODEL=
AI_PRICING_VERIFIED_AT=
AI_INPUT_MICROUSD_PER_MILLION=0
AI_CACHED_INPUT_MICROUSD_PER_MILLION=0
AI_CACHE_WRITE_MICROUSD_PER_MILLION=0
AI_OUTPUT_MICROUSD_PER_MILLION=0
AI_DAILY_LIMIT_MICROUSD=0
AI_MONTHLY_LIMIT_MICROUSD=0
AI_MAX_ARTICLES_PER_DAY=0
AI_MAX_TRANSLATION_LANGUAGES=0
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cryptonews
# DB_USERNAME=cryptonews
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_RETRY_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="news@cryptonews.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Demo values remain the default; live fetching requires an explicit rights review.
MARKET_DATA_MODE=demo
MARKET_DATA_RIGHTS_CONFIRMED=false
# Uses CACHE_STORE when unset. Production requires a shared persistent lock-capable store.
MARKET_CACHE_STORE=
MARKET_CRYPTO_REFRESH_MINUTES=10
MARKET_METALS_REFRESH_MINUTES=30
MARKET_STALE_MULTIPLIER=3
COINGECKO_API_TIER=demo
COINGECKO_API_KEY=
GOLDAPI_API_KEY=
